# ==========================================
# Database Configuration (Neon Postgres)
# ==========================================
# Get this connection string from your Neon dashboard (https://console.neon.tech)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ==========================================
# Admin Authentication
# ==========================================
# Default admin username
ADMIN_USERNAME="admin"

# Admin password hash generated using bcrypt (Cost factor 10 or 12).
# Example for password "Shaheen@2026":
ADMIN_PASSWORD_HASH="$2a$10$w1Q7Z7m8x4c6I0sK9r1UeOGYj7iI9nL0p1T2k3l4m5n6o7p8q9r0s"

# Secret key used for signing administrative session cookies (at least 32 characters)
SESSION_SECRET="replace-with-a-very-long-and-secure-random-secret-string-here"

# ==========================================
# Optional / Runtime Configuration
# ==========================================
NODE_ENV="production"
PORT=3000
